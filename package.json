{
  "name": "slide-panel",
  "version": "1.0.0",
  "description": "macOS menu bar slide-out webview panel",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:debug": "SLIDEPANEL_DEBUG=1 electron .",
    "claude:playwright": "node src/claude-playwright-launcher.js",
    "dist": "electron-builder --mac",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "keywords": [
    "electron",
    "macos",
    "menubar",
    "webview"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^10.0.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.slidepanel.app",
    "productName": "SlidePanel",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "SlidePanel ${version}"
    }
  }
}
